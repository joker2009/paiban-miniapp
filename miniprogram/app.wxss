page {
  --brand: #1f6feb;
  --brand-weak: #e8f0ff;
  --danger: #d93025;
  --warning: #b26a00;
  --success: #1a7f37;
  --text: #1b1f24;
  --text-weak: #6b7280;
  --border: #e5e7eb;
  --card: #ffffff;
  --bg: #f5f6f8;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.55;
}

.page {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.04);
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: var(--text-weak);
  font-size: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.subtitle {
  font-size: 26rpx;
  color: var(--text-weak);
  margin-top: 6rpx;
}

.divider {
  height: 1rpx;
  background: var(--border);
  margin: 20rpx 0;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  background: var(--brand);
  color: #fff;
}

.btn[disabled] {
  opacity: 0.45;
}

.btn-secondary {
  background: var(--brand-weak);
  color: var(--brand);
}

.btn-ghost {
  background: #fff;
  color: var(--text);
  border: 1rpx solid var(--border);
}

.btn-danger {
  background: #fdeceb;
  color: var(--danger);
}

.btn-sm {
  height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--brand-weak);
  color: var(--brand);
}

.tag-warn {
  background: #fff4e5;
  color: var(--warning);
}

.tag-danger {
  background: #fdeceb;
  color: var(--danger);
}

.tag-success {
  background: #e8f5ec;
  color: var(--success);
}

.tag-muted {
  background: #f0f1f3;
  color: var(--text-weak);
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--text-weak);
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  font-size: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--text-weak);
}

.notice {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff8e6;
  color: #8a5a00;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.notice-danger {
  background: #fdeceb;
  color: var(--danger);
}

.list-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.list-item:last-child {
  border-bottom: none;
}
