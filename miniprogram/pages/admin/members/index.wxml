<view class="page">
  <view class="card">
    <view class="row-between">
      <view class="title">员工花名册</view>
      <button class="btn btn-secondary btn-sm" bindtap="openAdd">添加员工</button>
    </view>
    <view class="muted">员工需通过管理员单独发放的邀请码绑定；工号在团队内唯一。</view>
  </view>

  <view class="card">
    <view class="empty" wx:if="{{loading && items.length === 0}}">加载中…</view>
    <view class="empty" wx:elif="{{items.length === 0}}">还没有员工</view>

    <view class="list-item" wx:for="{{items}}" wx:key="_id">
      <view class="row-between">
        <view>
          <view class="title">{{item.name}} <text class="muted">{{item.employeeNo}}</text></view>
          <view class="row" style="gap: 12rpx; margin-top: 6rpx;">
            <view class="tag tag-success" wx:if="{{item.bound}}">已绑定</view>
            <view class="tag tag-muted" wx:else>未绑定</view>
            <view class="tag tag-danger" wx:if="{{item.status !== 'ACTIVE'}}">已停用</view>
          </view>
        </view>
        <view class="actions">
          <text class="mini" data-id="{{item._id}}" bindtap="onIssue" wx:if="{{item.status === 'ACTIVE'}}">发邀请码</text>
          <text class="mini danger" data-id="{{item._id}}" bindtap="onToggleStatus">
            {{item.status === 'ACTIVE' ? '停用' : '启用'}}
          </text>
        </view>
      </view>
    </view>

    <view class="muted" style="text-align: center; padding-top: 16rpx;" wx:if="{{nextCursor}}" bindtap="loadMore">
      加载更多
    </view>
  </view>

  <view class="card" wx:if="{{invites.length > 0}}">
    <view class="title">有效邀请码</view>
    <view class="muted">邀请码只存摘要，明文仅在发放时展示一次。</view>
    <view class="list-item row-between" wx:for="{{invites}}" wx:key="inviteId">
      <view>
        <view>{{item.employeeName}}</view>
        <view class="muted">有效期至 {{item.expiresAt}}</view>
      </view>
      <text class="mini danger" data-id="{{item.inviteId}}" bindtap="onRevoke">撤销</text>
    </view>
  </view>
</view>

<!-- 添加员工 -->
<view class="mask" wx:if="{{addModal.visible}}" bindtap="closeAdd"></view>
<view class="sheet" wx:if="{{addModal.visible}}">
  <view class="title" style="margin-bottom: 20rpx;">添加员工</view>
  <view class="form-item">
    <text class="form-label">工号</text>
    <input class="input" value="{{addModal.employeeNo}}" data-field="employeeNo" bindinput="onField" placeholder="保留前导零" />
  </view>
  <view class="form-item">
    <text class="form-label">姓名</text>
    <input class="input" value="{{addModal.name}}" data-field="name" bindinput="onField" placeholder="内部姓名" />
  </view>
  <button class="btn" bindtap="onAddSubmit" loading="{{busy}}" disabled="{{busy}}">保存</button>
  <button class="btn btn-ghost" style="margin-top: 12rpx;" bindtap="closeAdd">取消</button>
</view>

<!-- 邀请码 -->
<view class="mask" wx:if="{{codeModal.visible}}" bindtap="closeCode"></view>
<view class="sheet" wx:if="{{codeModal.visible}}">
  <view class="title">邀请码已生成</view>
  <view class="muted">仅展示这一次，请私发给 {{codeModal.employeeName}}。有效期至 {{codeModal.expiresAt}}。</view>
  <view class="code-box">{{codeModal.code}}</view>
  <button class="btn" bindtap="copyCode">复制邀请码</button>
  <button class="btn btn-ghost" style="margin-top: 12rpx;" bindtap="closeCode">完成</button>
</view>
