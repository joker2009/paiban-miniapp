.head {
  padding: 8rpx 8rpx 20rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.next-card {
  background: linear-gradient(135deg, #1f6feb, #3f8cff);
  color: #fff;
}

.next-card .next-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.next-card .next-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.next-card .next-time {
  font-size: 28rpx;
  opacity: 0.92;
  margin-top: 6rpx;
}

.next-card .tag {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.next-btn {
  margin-top: 24rpx;
  background: #fff;
  color: #1f6feb;
}

.week-head {
  padding-bottom: 8rpx;
}

.week-label {
  font-weight: 600;
}

.day {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--border);
}

.day-today {
  background: #f7faff;
  border-radius: 12rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.day-date {
  font-size: 26rpx;
  color: var(--text-weak);
}

.shift-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.day-right {
  flex-shrink: 0;
  padding-left: 16rpx;
  padding-top: 20rpx;
}
