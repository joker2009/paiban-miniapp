<view class="page">
  <!-- 第一步：选图 -->
  <block wx:if="{{step === 'UPLOAD'}}">
    <view class="card">
      <view class="row-between">
        <view>
          <view class="title">{{weekText}}</view>
          <view class="muted">导入哪一周的班表</view>
        </view>
        <view class="row" style="gap: 16rpx;">
          <text class="mini" bindtap="prevWeek">上一周</text>
          <text class="mini" bindtap="nextWeek">下一周</text>
        </view>
      </view>

      <button class="btn" style="margin-top: 24rpx;" bindtap="chooseFromChat" disabled="{{busy}}">
        从微信聊天选图
      </button>
      <button class="btn btn-ghost" style="margin-top: 16rpx;" bindtap="chooseFromAlbum" disabled="{{busy}}">
        从相册选图
      </button>
      <view class="muted" style="margin-top: 16rpx; text-align: center;">
        每批最多 {{maxCount}} 张，单图不超过 10MB
      </view>
      <view class="muted" style="margin-top: 8rpx; text-align: center;">
        实际日期以图片表头为准；所选周仅在没有识别到日期时兜底
      </view>
    </view>

    <view class="card" wx:if="{{files.length > 0}}">
      <view class="title">已选 {{files.length}} 张</view>
      <view class="file list-item" wx:for="{{files}}" wx:key="path">
        <view class="row-between">
          <view>
            <view>{{index + 1}}. {{item.name}}</view>
            <view class="muted">{{item.sizeText}}</view>
          </view>
          <text class="mini danger" wx:if="{{!busy}}" data-index="{{index}}" bindtap="removeFile">移除</text>
        </view>
      </view>

      <button class="btn" style="margin-top: 20rpx;" bindtap="startRecognize" loading="{{busy}}" disabled="{{busy}}">
        上传并识别
      </button>
      <view class="muted" style="text-align: center; margin-top: 12rpx;" wx:if="{{progressText}}">
        {{progressText}}
      </view>
    </view>

    <view class="notice notice-danger" wx:if="{{errorMsg}}">{{errorMsg}}</view>
  </block>

  <!-- 第二步：选自己 -->
  <block wx:elif="{{step === 'PICK'}}">
    <view class="card" wx:if="{{previewImages.length > 0}}">
      <view class="row-between">
        <view class="title">原图核对</view>
        <view class="muted">点击放大</view>
      </view>
      <scroll-view scroll-x class="preview-strip">
        <image
          wx:for="{{previewImages}}"
          wx:key="fileID"
          src="{{item.url}}"
          mode="aspectFill"
          class="preview-thumb"
          data-index="{{index}}"
          bindtap="previewOriginal"
        />
      </scroll-view>
      <view class="muted" wx:if="{{detectedRangeText}}">识别日期：{{detectedRangeText}}</view>
    </view>

    <view class="card">
      <view class="title">找到你了</view>
      <view class="subtitle">从识别出的名单里选择你自己的名字</view>
    </view>

    <view class="card">
      <view class="notice" wx:if="{{preferredNotice}}">{{preferredNotice}}</view>
      <input
        class="input"
        style="margin-bottom: 16rpx;"
        placeholder="搜索姓名或工号"
        value="{{rowQuery}}"
        bindinput="onRowQuery"
      />
      <view class="muted" wx:if="{{visibleRows.length === 0}}">没有匹配的姓名，请检查输入</view>
      <view
        class="row list-item"
        wx:for="{{visibleRows}}"
        wx:key="index"
        data-index="{{item.index}}"
        bindtap="pickRow"
      >
        <view class="row-main">
          <view class="title">{{item.label}}</view>
          <view class="muted">{{item.preview}}</view>
        </view>
        <view class="tag tag-success" wx:if="{{item.preferred}}">设置姓名</view>
        <view class="tag" wx:else>选择</view>
      </view>
    </view>

    <button class="btn btn-ghost" bindtap="backToUpload">重新选图</button>
  </block>

  <!-- 第三步：校对 + 设置时间 -->
  <block wx:else>
    <view class="card">
      <view class="row-between">
        <view>
          <view class="title">{{selectedName}}</view>
          <view class="muted">{{detectedRangeText || weekText}}</view>
        </view>
        <text class="mini" bindtap="backToPick">换人</text>
      </view>
      <view class="muted" style="margin-top: 8rpx;">可直接修改每天的班次文字；空白表示当天不排班。</view>
    </view>

    <view class="card" wx:if="{{previewImages.length > 0}}">
      <view class="row-between">
        <view class="title">原图核对</view>
        <view class="muted">点击放大</view>
      </view>
      <scroll-view scroll-x class="preview-strip">
        <image
          wx:for="{{previewImages}}"
          wx:key="fileID"
          src="{{item.url}}"
          mode="aspectFill"
          class="preview-thumb"
          data-index="{{index}}"
          bindtap="previewOriginal"
        />
      </scroll-view>
    </view>

    <view class="card">
      <view class="day-row" wx:for="{{days}}" wx:key="date">
        <view class="day-date">{{item.dayText}}</view>
        <input
          class="day-input"
          value="{{item.text}}"
          placeholder="休"
          data-index="{{index}}"
          bindinput="onDayInput"
        />
      </view>
    </view>

    <view class="card" wx:if="{{shiftDefs.length > 0}}">
      <view class="title">班次时间</view>
      <view class="muted">用于写入系统日历；休息类班次不填时间。</view>

      <view class="def-item" wx:for="{{shiftDefs}}" wx:key="label">
        <view class="row-between">
          <view class="def-label">{{item.label}}</view>
          <view class="tag tag-muted" wx:if="{{item.category === 'OFF'}}">休息，不提醒</view>
        </view>

        <block wx:if="{{item.category !== 'OFF'}}">
          <view class="def-time-row">
            <picker mode="time" value="{{item.startLocal}}" data-index="{{index}}" data-field="startLocal" bindchange="onDefTime">
              <view class="input def-time">{{item.startLocal || '开始'}}</view>
            </picker>
            <text class="muted">至</text>
            <picker mode="time" value="{{item.endLocal}}" data-index="{{index}}" data-field="endLocal" bindchange="onDefTime">
              <view class="input def-time">{{item.endLocal || '结束'}}</view>
            </picker>
          </view>
          <view class="switch-row">
            <view class="muted">结束于次日</view>
            <switch checked="{{item.endDayOffset === 1}}" data-index="{{index}}" bindchange="onDefOffset" color="#1f6feb" />
          </view>
          <view class="switch-row">
            <view class="muted">上班前 30 分钟提醒</view>
            <switch checked="{{item.reminderEnabled}}" data-index="{{index}}" bindchange="onDefReminder" color="#1f6feb" />
          </view>
        </block>
      </view>
    </view>

    <button class="btn" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存到我的班表</button>
  </block>
</view>
