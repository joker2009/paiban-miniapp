.mini {
  font-size: 26rpx;
  color: var(--brand);
}

.preview-strip {
  white-space: nowrap;
  margin: 16rpx 0 12rpx;
}

.preview-thumb {
  display: inline-block;
  width: 240rpx;
  height: 240rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
}

.mini.danger {
  color: var(--danger);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.day-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.day-row:last-child {
  border-bottom: none;
}

.day-date {
  width: 180rpx;
  font-size: 26rpx;
  color: var(--text-weak);
}

.day-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.def-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.def-item:last-child {
  border-bottom: none;
}

.def-label {
  font-size: 30rpx;
  font-weight: 600;
}

.def-time-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.def-time {
  min-width: 180rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
